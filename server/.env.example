PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/helpdesk
BETTER_AUTH_SECRET=YOUR_SECRET_FROM_OPENSSL_RAND_BASE64_32
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
INBOUND_EMAIL_SECRET=YOUR_SECRET_FROM_OPENSSL_RAND_BASE64_32
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
EMAIL_FROM=YOUR_SUPPORT_ADDRESS_ON_YOUR_AUTHENTICATED_DOMAIN
# Both are needed for student replies to reach the app. Set them only after SendGrid Inbound
# Parse is working for this domain, because replies go there as soon as they are set.
INBOUND_REPLY_DOMAIN=YOUR_INBOUND_PARSE_SUBDOMAIN
INBOUND_PARSE_SECRET=YOUR_SECRET_FROM_OPENSSL_RAND_HEX_32
# Optional. The agent who gets tickets the AI couldn't resolve. Without it, they arrive unassigned.
DEFAULT_AGENT_EMAIL=YOUR_DEFAULT_AGENT_EMAIL
# Optional. Without a DSN, nothing is sent to Sentry.
SENTRY_DSN=YOUR_HELPDESK_BACKEND_DSN
SENTRY_ENVIRONMENT=development
