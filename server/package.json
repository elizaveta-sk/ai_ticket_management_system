{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "bunx --bun prisma generate",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:ai-agent": "bun prisma/seed-ai-agent.ts",
    "db:seed:tickets": "bun prisma/seed-demo-tickets.ts",
    "db:seed:replies": "bun prisma/seed-ticket-replies.ts",
    "db:studio": "bunx --bun prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sendgrid/mail": "^8.1.6",
    "ai": "^7.0.159",
    "better-auth": "^1.7.14",
    "core": "workspace:*",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "dotenv": "^18.0.9",
    "prisma": "7.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
